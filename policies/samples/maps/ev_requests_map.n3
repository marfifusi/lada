###############################################################################
# Namespaces
###############################################################################
@prefix sotw: <https://w3id.org/force/sotw#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix lada: <https://w3id.org/lada#> .
@prefix ex: <http://example.com/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
###############################################################################


###############################################################################
# Un request parameter di tipo sotw:CurrentXSDDateTime esprime
# un odrl:datetime per le policy
###############################################################################
{
  ?param a sotw:RequestParameter .
  ?param sotw:describesFeature sotw:CurrentXSDDateTime .
  ?param sotw:value ?value .
}
=>
{
  _:requestAssertion a lada:RequestAssertion .
  _:requestAssertion lada:fromParameter ?param .
  _:requestAssertion lada:hasConstraintSatisfier _:constraintSatisfier .

  _:constraintSatisfier a lada:ConstraintSatisfier .
  _:constraintSatisfier odrl:leftOperand odrl:dateTime .
  _:constraintSatisfier odrl:operator odrl:eq .
  _:constraintSatisfier odrl:rightOperand ?value .
} .
###############################################################################


###############################################################################
# Un request parameter di tipo sotw:CurrentXSDDateTime esprime
# un ex:dayOfWeek per le policy. Il segnaposto "dayOfWeek"^^xsd:string
# verrà sostituito dal nome del giorno giusto con una modifica applicata
# hard-coded, pyling-n3 non supporta questo calcolo.
###############################################################################
{
  ?param a sotw:RequestParameter .
  ?param sotw:describesFeature sotw:CurrentXSDDateTime .
  ?param sotw:value ?value .
}
=>
{
  _:requestAssertion a lada:RequestAssertion .
  _:requestAssertion lada:fromParameter ?param .
  _:requestAssertion lada:hasConstraintSatisfier _:constraintSatisfier .

  _:constraintSatisfier a lada:ConstraintSatisfier .
  _:constraintSatisfier odrl:leftOperand ex:dayOfWeek .
  _:constraintSatisfier odrl:operator odrl:eq .
  _:constraintSatisfier odrl:rightOperand "dayOfWeek"^^xsd:string .
} .
###############################################################################


###############################################################################
# Un request parameter di tipo sotw:Resolution esprime
# un odrl:resolution per le policy
###############################################################################
{
  ?param a sotw:RequestParameter .
  ?param sotw:describesFeature sotw:Resolution .
  ?param sotw:value ?value .
}
=>
{
  _:requestAssertion a lada:RequestAssertion .
  _:requestAssertion lada:fromParameter ?param .
  _:requestAssertion lada:hasConstraintSatisfier _:constraintSatisfier .

  _:constraintSatisfier a lada:ConstraintSatisfier .
  _:constraintSatisfier odrl:leftOperand odrl:resolution .
  _:constraintSatisfier odrl:operator odrl:eq .
  _:constraintSatisfier odrl:rightOperand ?value .
} .
###############################################################################


###############################################################################
# Se nessuna altra regola ha già creato una RequestAssertion da un
# RequestParameter, la feature del parametro è il leftOperand del
# ConstraintSatisfier. Così la policy può confrontare il proprio
# leftOperand con la feature.
###############################################################################
{
  ?param a sotw:RequestParameter .
  ?param sotw:describesFeature ?feature .
  ?param sotw:value ?value .
  _:scope log:notIncludes {
    ?assertion a lada:RequestAssertion .
    ?assertion lada:fromParameter ?param .
  } .
}
=>
{
  _:requestAssertion a lada:RequestAssertion .
  _:requestAssertion lada:fromParameter ?param .
  _:requestAssertion lada:hasConstraintSatisfier _:constraintSatisfier .

  _:constraintSatisfier a lada:ConstraintSatisfier .
  _:constraintSatisfier odrl:leftOperand ?feature .
  _:constraintSatisfier odrl:operator odrl:eq .
  _:constraintSatisfier odrl:rightOperand ?value .
} .
###############################################################################
