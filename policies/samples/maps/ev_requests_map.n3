###############################################################################
# Namespaces
###############################################################################
@prefix sotw: <https://w3id.org/force/sotw#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix lada: <https://w3id.org/lada#> .
@prefix ex: <http://example.com/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
###############################################################################


###############################################################################
# Una EvaluationRequest esprime l'azione che si intende compiere.
###############################################################################
{
  ?evr a sotw:EvaluationRequest .
  ?evr sotw:evaluatedAction ?action .
}
=>
{
  lada:actionIntention a lada:ActionIntention .
  lada:actionIntention lada:fromRequest ?evr .
  lada:actionIntention lada:intentionOf ?action .
} .
###############################################################################


###############################################################################
# Un request parameter di tipo sotw:CurrentXSDDateTime esprime
# un odrl:datetime per le policy, appeso all'action intention.
###############################################################################
{
  lada:actionIntention lada:fromRequest ?evr .
  ?evr sotw:requestParameter ?param .
  ?param sotw:describesFeature sotw:CurrentXSDDateTime .
  ?param sotw:value ?value .
}
=>
{
  lada:actionIntention lada:hasConstraintSatisfier _:constraintSatisfier .
  _:constraintSatisfier a lada:ConstraintSatisfier .
  _:constraintSatisfier odrl:leftOperand odrl:dateTime .
  _:constraintSatisfier odrl:operator odrl:eq .
  _:constraintSatisfier odrl:rightOperand ?value .
  _:constraintSatisfier lada:fromParameter ?param .
} .
###############################################################################


###############################################################################
# Un request parameter di tipo sotw:CurrentXSDDateTime esprime
# un ex:dayOfWeek per le policy, appeso all'action intention.
# Il segnaposto "dayOfWeek"^^xsd:string verrà sostituito dal nome del
# giorno giusto con una modifica applicata hard-coded, pyling-n3 non
# supporta questo calcolo.
###############################################################################
{
  lada:actionIntention lada:fromRequest ?evr .
  ?evr sotw:requestParameter ?param .
  ?param sotw:describesFeature sotw:CurrentXSDDateTime .
  ?param sotw:value ?value .
}
=>
{
  lada:actionIntention lada:hasConstraintSatisfier _:constraintSatisfier .
  _:constraintSatisfier a lada:ConstraintSatisfier .
  _:constraintSatisfier odrl:leftOperand ex:dayOfWeek .
  _:constraintSatisfier odrl:operator odrl:eq .
  _:constraintSatisfier odrl:rightOperand "dayOfWeek"^^xsd:string .
  _:constraintSatisfier lada:fromParameter ?param .
} .
###############################################################################


###############################################################################
# Un request parameter di tipo sotw:Resolution esprime
# un odrl:resolution per le policy, appeso all'action intention.
###############################################################################
{
  lada:actionIntention lada:fromRequest ?evr .
  ?evr sotw:requestParameter ?param .
  ?param sotw:describesFeature sotw:Resolution .
  ?param sotw:value ?value .
}
=>
{
  lada:actionIntention lada:hasConstraintSatisfier _:constraintSatisfier .
  _:constraintSatisfier a lada:ConstraintSatisfier .
  _:constraintSatisfier odrl:leftOperand odrl:resolution .
  _:constraintSatisfier odrl:operator odrl:eq .
  _:constraintSatisfier odrl:rightOperand ?value .
  _:constraintSatisfier lada:fromParameter ?param .
} .
###############################################################################


###############################################################################
# Se nessuna regola ha già creato un ConstraintSatisfier da questo
# parametro, la feature è il leftOperand del ConstraintSatisfier appeso
# all'action intention. Una regola nuova in cima non si elenca qui:
# nel conseguente basta lada:fromParameter sullo stesso parametro.
###############################################################################
{
  lada:actionIntention lada:fromRequest ?evr .
  ?evr sotw:requestParameter ?param .
  ?param sotw:describesFeature ?feature .
  ?param sotw:value ?value .
  _:scope log:notIncludes {
    ?satisfier a lada:ConstraintSatisfier .
    ?satisfier lada:fromParameter ?param .
  } .
}
=>
{
  lada:actionIntention lada:hasConstraintSatisfier _:constraintSatisfier .
  _:constraintSatisfier a lada:ConstraintSatisfier .
  _:constraintSatisfier odrl:leftOperand ?feature .
  _:constraintSatisfier odrl:operator odrl:eq .
  _:constraintSatisfier odrl:rightOperand ?value .
  _:constraintSatisfier lada:fromParameter ?param .
} .
###############################################################################
