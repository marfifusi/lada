###############################################################################
# Namespaces
###############################################################################
@prefix sotw: <https://w3id.org/force/sotw#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix lada: <https://w3id.org/lada#> .
@prefix ex: <http://example.com/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix pay: <https://www.epimorphics.com/guide-to-the-payments-ontology/> .
###############################################################################


###############################################################################
# Un pagamento nello SOTW esprime un odrl:payAmount per le policy
###############################################################################
{
  ?param a pay:Payment .
  ?param pay:netAmount ?value .
  ?param pay:currency ?currency .
  ?param pay:paymentDate ?dateTime .
  ?param sotw:conditionId ?cid .
}
=>
{
  # La action che viene confrontata con la duty nella policy
  _:sotwAction a lada:SotwAction .
  _:sotwAction lada:fromContext ?param .
  _:sotwAction lada:dutyReference ?cid .
  _:sotwAction lada:hasRefinementSatisfier _:refinementSatisfier .

  # datetime dell'azione
  _:sotwEventDateTime a lada:SotwEventDateTime .
  _:sotwAction lada:eventDateTime _:sotwEventDateTime .
  _:sotwEventDateTime lada:dateTime ?dateTime .

  # Refinement dell'azione
  _:refinementSatisfier a lada:RefinementSatisfier .
  _:refinementSatisfier odrl:leftOperand odrl:payAmount .
  _:refinementSatisfier odrl:operator odrl:eq .
  _:refinementSatisfier odrl:rightOperand ?value .
  _:refinementSatisfier odrl:unit ?currency .

} .
###############################################################################
