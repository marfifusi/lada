###############################################################################
# Namespaces
###############################################################################
@prefix sotw: <https://w3id.org/force/sotw#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix lada: <https://w3id.org/lada#> .
@prefix ex: <http://example.com/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix pay: <https://www.epimorphics.com/guide-to-the-payments-ontology/> .
###############################################################################


###############################################################################
# odrl:partOf è transitiva: se A è parte di B e B è parte di C, A è parte di C.
###############################################################################
{
  ?a odrl:partOf ?b .
  ?b odrl:partOf ?c .
}
=>
{
  ?a odrl:partOf ?c .
} .
###############################################################################


###############################################################################
# Un pagamento nello SOTW esprime un odrl:payAmount per le policy
###############################################################################
{
  ?param a pay:Payment .
  ?param pay:netAmount ?value .
  ?param pay:currency ?currency .
  ?param pay:paymentDate ?dateTime .
  ?param sotw:conditionId ?cid .
}
=>
{
  # La action che viene confrontata con la duty nella policy
  _:sotwAction a lada:SotwAction .
  _:sotwAction lada:fromContext ?param .
  _:sotwAction sotw:conditionId ?cid .
  _:sotwAction lada:actionType odrl:compensate .
  _:sotwAction lada:hasConstraintSatisfier _:constraintSatisfier .

  # datetime dell'azione
  _:sotwAction lada:atTime ?dateTime .

  # ConstraintSatisfier dell'azione (una refinement è un odrl:Constraint)
  _:constraintSatisfier a lada:ConstraintSatisfier .
  _:constraintSatisfier odrl:leftOperand odrl:payAmount .
  _:constraintSatisfier odrl:operator odrl:eq .
  _:constraintSatisfier odrl:rightOperand ?value .
  _:constraintSatisfier odrl:unit ?currency .

} .
###############################################################################
